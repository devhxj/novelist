{
  "schema_id": "reference-corpus.feature.trope.v1",
  "schema_version": "reference-corpus-feature-family-v1",
  "family": "trope",
  "node_type": "scene",
  "max_observations": 4,
  "required_observation_fields": ["feature_key", "trope_family", "stage", "emotional_payoff", "delivery_mode", "confidence", "evidence_start", "evidence_end", "explanation"],
  "observation_fields": {
    "feature_key": { "type": "enum", "enum": ["trope_pattern"] },
    "trope_family": { "type": "enum", "enum": ["face_slap", "broken_engagement", "hidden_strength", "desperate_counterattack", "identity_reveal", "misunderstanding_resolved", "treasure_hunt", "duel", "rescue", "chase", "auction", "secret_realm"] },
    "stage": { "type": "enum", "enum": ["setup", "trigger", "development", "climax", "aftermath"] },
    "emotional_payoff": { "type": "enum", "enum": ["satisfaction", "tension", "sorrow", "warmth", "anticipation", "anger", "suspense"] },
    "delivery_mode": { "type": "enum", "enum": ["standard", "variation", "anti_trope"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 0.95 },
    "evidence_start": { "type": "integer", "minimum": 0 },
    "evidence_end": { "type": "integer", "minimum": 1 },
    "explanation": { "type": "string", "max_length": 360 }
  }
}
